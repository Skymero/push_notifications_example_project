          {
            "key": "activeDeviceId",
            "type": "string",
            "size": 128,
            "required": false,
            "default": null
          },
          {
            "key": "activeDeviceTokenId",
            "type": "string",
            "size": 64,
            "required": false,
            "default": null
          },
          {
            "key": "createdAt",
            "type": "datetime",
            "required": true,
            "default": null
          },
          {
            "key": "updatedAt",
            "type": "datetime",
            "required": true,
            "default": null
          }
