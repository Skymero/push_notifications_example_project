        "attributes": [
          {
            "key": "userId",
            "type": "string",
            "size": 64,
            "required": true,
            "default": null
          },
          {
            "key": "username",
            "type": "string",
            "size": 100,
            "required": true,
            "default": null
          },
          {
            "key": "notificationEnabled",
            "type": "boolean",
            "required": true,
            "default": false
