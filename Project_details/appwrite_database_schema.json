            "key": "buildNumber",
            "type": "string",
            "size": 64,
            "required": false,
            "default": null
          },
          {
            "key": "permissionStatus",
            "type": "enum",
            "required": true,
            "default": "unknown",
            "elements": [
              "granted",
              "denied",
              "not_requested",
              "unknown"
            ]
          },
          {
            "key": "tokenStatus",
            "type": "enum",
            "required": true,
            "default": "untested",
            "elements": [
              "untested",
              "valid",
              "invalid",
              "rotated",
              "revoked"
