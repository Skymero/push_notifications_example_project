        "collectionPermissions": {
          "read": [],
          "create": [],
          "update": [],
          "delete": []
        },
        "documentReadPermissions": [
          "user:{userId}"
        ],
        "attributes": [
          {
            "key": "deviceTokenId",
            "type": "string",
            "size": 64,
            "required": true,
            "default": null
